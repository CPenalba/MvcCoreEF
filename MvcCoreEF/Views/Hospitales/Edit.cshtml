@model Hospital<h1 style="color:blue">Update</h1><p>    <a asp-controller="Hospitales" asp-action="Index">Back to list</a></p><form method="post">    <label>Id hospital</label>    <input type="text" name="idhospital" class="form-control" value="@Model.IdHospital" />    <label>Nombre</label>    <input type="text" name="nombre" class="form-control" value="@Model.Nombre" />    <label>Dirección</label>    <input type="text" name="direccion" class="form-control" value="@Model.Direccion" />    <label>Teléfono</label>    <input type="text" name="telefono" class="form-control" value="@Model.Telefono" />    <label>Camas</label>    <input type="text" name="camas" class="form-control" value="@Model.Camas" />    <button class="btn btn-dark">Update</button></form>